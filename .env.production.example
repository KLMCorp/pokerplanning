# =============================================================================
# Poker Planning - Configuration Production
# =============================================================================
# Copiez ce fichier en .env pour la production

# Application
APP_NAME=Poker Planning
APP_URL=https://poker.example.com
PORT=3001

# Socket.IO : URL vue par les navigateurs, lue au lancement (vide = même hôte, port 3001,
# ou origine de la page derrière un reverse proxy)
# Proxmox : sans effet pour l'interface, voir README (reserve Proxmox).
# SOCKET_URL=https://poker.example.com

# Uploads d'images (false = désactivés)
# ALLOW_UPLOADS=true

# SMTP - Configurez votre serveur SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=votre-mot-de-passe
SMTP_FROM=noreply@example.com
