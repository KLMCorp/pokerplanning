{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node20",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false
  },
  "include": ["server/**/*", "src/types/**/*"],
  "exclude": ["node_modules"]
}
