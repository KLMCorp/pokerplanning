# =============================================================================
# Poker Planning - Configuration
# =============================================================================
# Copiez ce fichier en .env et adaptez les valeurs

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Nom de l'application (affiché dans les emails)
APP_NAME=Poker Planning

# URL publique de l'application (sans slash final)
APP_URL=https://poker.example.com

# Port du serveur Socket.IO (backend)
PORT=3001

# Origines CORS autorisées (séparées par des virgules)
# Par défaut, utilise APP_URL + localhost
# CORS_ORIGINS=https://poker.example.com,http://localhost:3000

# -----------------------------------------------------------------------------
# Socket.IO (côté navigateur)
# -----------------------------------------------------------------------------
# URL du serveur Socket.IO telle que les navigateurs la joignent, lue AU LANCEMENT
# (Docker : -e SOCKET_URL=...). Format http(s)://hote[:port], sans chemin.
# Vide : même hôte que la page et port 3001 si la page est servie en http sur le port 3000,
# sinon origine de la page (reverse proxy qui route /socket.io/). Reverse proxy servi en
# http sur le port 3000 : indiquer l'origine de la page.
# Proxmox : sans effet pour l'interface (le service Next ne lit pas ce fichier et next build n'inline pas SOCKET_URL) : utiliser NEXT_PUBLIC_SOCKET_URL + rebuild, ou Environment=SOCKET_URL=... sur planning-poker-web.service.
# SOCKET_URL=http://192.168.1.10:3001
#
# Ancienne variable, figée au build (next build) : conservée pour les installations
# qui buildent sur place ; SOCKET_URL est prioritaire.
# NEXT_PUBLIC_SOCKET_URL=

# -----------------------------------------------------------------------------
# SMTP - Configuration email
# -----------------------------------------------------------------------------
# Hôte du serveur SMTP
SMTP_HOST=smtp.example.com

# Port SMTP (587 pour TLS, 465 pour SSL, 25 pour non-sécurisé)
SMTP_PORT=587

# Connexion sécurisée (true pour SSL/465, false pour TLS/587 avec STARTTLS)
SMTP_SECURE=false

# Identifiant SMTP
SMTP_USER=noreply@example.com

# Mot de passe SMTP
SMTP_PASSWORD=your-smtp-password

# Adresse email d'expédition
SMTP_FROM=noreply@example.com

# -----------------------------------------------------------------------------
# Chemins des ressources (optionnel)
# -----------------------------------------------------------------------------
# Chemin de base pour les images de cartes
# Par défaut: /images/cartes
# CARDS_PATH=/images/cartes
# NEXT_PUBLIC_CARDS_PATH=/images/cartes

# Répertoire des données (base SQLite)
# Par défaut: ./data
# DATA_DIR=/app/data

# -----------------------------------------------------------------------------
# Limites (optionnel)
# -----------------------------------------------------------------------------
# Nombre maximum de participants par room (0 = illimité)
# MAX_PARTICIPANTS_PER_ROOM=0

# Autoriser les uploads d'images (avatar, cartes personnalisées, fond de table), lu au lancement
# Par défaut: true. Mettre à false pour désactiver tous les uploads d'images (serveur et interface)
# ALLOW_UPLOADS=true

# -----------------------------------------------------------------------------
# Réseau / proxy
# -----------------------------------------------------------------------------
# Nombre de reverse proxies de confiance devant le serveur Node (lecture de X-Forwarded-For depuis la droite).
# 0 (défaut) = connexion directe, X-Forwarded-For ignoré. 1 = un nginx devant (cas de nginx.conf.example).
# 'true' est accepté et vaut 1. OBLIGATOIRE derrière un proxy : sinon tous les clients ont l'IP du proxy,
# et les limites (connexions WS, rate limits) deviennent globales.
# Derrière 2 proxys (CDN + nginx), mettre 2.
# TRUST_PROXY=1

# Nombre max de connexions WebSocket simultanées par IP (défaut 20, 0 = illimité)
# MAX_WS_CONNECTIONS_PER_IP=20

# Créations de room par IP et par minute (défaut 10, 0 = pas de limite)
# ROOM_CREATE_RATE_LIMIT_PER_MINUTE=10

# Plafond global de rooms actives (0 = illimité, défaut)
# MAX_ACTIVE_ROOMS=0

# Délai de grâce (ms) après une déconnexion avant que l'utilisateur soit retiré de la room
# (si c'est le PO qui ne revient pas, la room est fermée pour tous). Défaut : 30000
# RECONNECT_GRACE_PERIOD_MS=30000

# URL interne du serveur Socket.IO/Express utilisée par Next pour servir /uploads sans nginx.
# Valeur figée AU BUILD (next build). Défaut : http://127.0.0.1:3001
# UPLOADS_UPSTREAM_URL=http://127.0.0.1:3001

# -----------------------------------------------------------------------------
# Build Docker (docker-compose)
# -----------------------------------------------------------------------------
# Le Dockerfile utilisé par docker-compose clone le code depuis un dépôt Git :
# GIT_REPO (URL du dépôt, OBLIGATOIRE) et GIT_BRANCH (tag ou branche à construire, défaut : main).
# À défaut, construire depuis les sources locales : docker build -f Dockerfile.local -t pokerplanning .
# GIT_REPO=https://your-git-server/PlanningPoker.git
# GIT_BRANCH=main

# -----------------------------------------------------------------------------
# Administration
# -----------------------------------------------------------------------------
# Email du super administrateur (seul compte pouvant accéder à /admin)
# Si non défini, la page admin est désactivée
# ⚠️ Sécurité : le premier compte inscrit avec l'email ADMIN_EMAIL obtient les droits admin. L'adresse n'est
# pas vérifiée. Créez ce compte IMMÉDIATEMENT après le premier déploiement, avant toute exposition publique.
# Sinon, n'importe qui connaissant ou devinant l'adresse peut s'approprier l'administration.
# ADMIN_EMAIL=admin@example.com

# Chemin personnalisé pour la page admin (optionnel, côté serveur uniquement)
# Si défini, /admin sera bloqué et seul ce chemin donnera accès à la page admin
# Exemple: /secret-dashboard-42
# Valeur figée au build (next build) : rebuild nécessaire pour la changer. Avec Docker, passée en build arg :
# elle est visible dans `docker history` de l'image.
# ADMIN_SECRET_PATH=/secret-dashboard-42

# -----------------------------------------------------------------------------
# TTL des rooms
# -----------------------------------------------------------------------------
# Durée de vie maximale des rooms en minutes (par défaut: 180 = 3 heures)
# Les utilisateurs peuvent configurer un TTL inférieur dans leur compte
ROOM_TTL_MINUTES=180

# -----------------------------------------------------------------------------
# Node.js (optionnel)
# -----------------------------------------------------------------------------
# Mode de l'application
# NODE_ENV=production
